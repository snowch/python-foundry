{
  "name": "python-foundry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs && python tests/native-course.py && python tests/tinydb-test.py && python tests/kernel-test.py",
    "test:browser": "node tests/browser.cjs && node tests/updates.cjs && node tests/tinydb-browser.cjs && node tests/visual-models.cjs",
    "dev": "node scripts/serve.mjs",
    "test:hub": "node tests/hub-selection.cjs && node tests/lab-hub.cjs",
    "test:navigation": "node tests/navigation.cjs"
  },
  "dependencies": {
    "pyodide": "314.0.2",
    "@codemirror/commands": "6.10.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.8",
    "@lezer/highlight": "1.2.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1"
  }
}
